    "members:sync": "pnpm members:fetch && pnpm members:avatars",
    "airtable:setup": "node --env-file-if-exists=.env scripts/airtable-setup.mjs",
    "airtable:seed": "node --env-file-if-exists=.env scripts/airtable-setup.mjs --seed"
  },
  "dependencies": {
    "nuxt": "^3.13.0",
