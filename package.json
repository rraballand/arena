    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.0",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vue-tsc": "^3.3.11"
  }
