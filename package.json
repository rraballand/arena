{
  "name": "tournament",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "members:fetch": "node --env-file-if-exists=.env scripts/fetch-members.mjs",
